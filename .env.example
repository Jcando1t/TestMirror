TESTMIRROR_DATABASE_PATH=data/testmirror.db
TESTMIRROR_MAX_RETRIES=2
TESTMIRROR_USE_DEEPSEEK=false

# Optional: used by the LLM-backed ClassificationAgent and AnalysisAgent.
# The default workflow is deterministic and needs no API key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
